# Production environment for shopghab.ir (copy to .env on the VPS; do not commit .env)

NEXT_PUBLIC_SITE_URL=https://shopghab.ir
API_BASE_URL=https://api.k3isonfire.ir/api/v1
NEXT_PUBLIC_API_TENANT_ID=shop-ghab

# Optional: override browser API base (default uses /api/v1 proxy)
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Admin login credentials
ADMIN_PHONE_NUMBER=admin
ADMIN_PASSWORD=changeme

# Optional: fixed OTP code for development/testing only
# OTP_DEV_CODE=
